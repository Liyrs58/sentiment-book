# Optional Hugging Face token — POST /api/sentiment calls ProsusAI/finbert.
# HF_TOKEN=hf_...

# Optional. Only set if you have wired a lawful scrape adapter in lib/scrape.ts.
# LIVE_SCRAPE=1

# Optional NVIDIA NIM — PM prose notes only (scoring stays FinBERT/lexicon).
# Key: https://build.nvidia.com/settings  (nvapi-…)
# Endpoint: https://integrate.api.nvidia.com/v1/chat/completions
# Model locked: google/gemma-4-31b-it
# NVIDIA_API_KEY=

# Force mock PM notes even if NVIDIA_API_KEY is set.
# LLM_PROVIDER=mock

# Always false — no live broker / live orders. Env cannot enable it.
LIVE_TRADING=false

# Optional durable store for pipeline-cache / session (beyond /tmp).
# When unset, the committed data/pipeline-cache.json corpus dump is used.
# BLOB_READ_WRITE_TOKEN=

# Optional cookie gate. Unset DEMO_ACCESS_CODE = public desk.
# When set, visitors need the code; cookie is HMAC-signed with AUTH_SECRET
# (falls back to DEMO_ACCESS_CODE if AUTH_SECRET is empty).
# DEMO_ACCESS_CODE=
# AUTH_SECRET=

# Optional Alpaca paper sleeve (not required for HARLF research).
# Default off. Scoring stays lexicon/FinBERT. Base URL is locked to paper.
# PAPER_BROKER=off
# ALPACA_API_KEY=
# ALPACA_API_SECRET=
# PAPER_BROKER=alpaca
