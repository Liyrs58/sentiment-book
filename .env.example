# Optional Hugging Face token — POST /api/sentiment calls ProsusAI/finbert.
# HF_TOKEN=hf_...

# Optional. Only set if you have wired a lawful scrape adapter in lib/scrape.ts.
# LIVE_SCRAPE=1

# Optional NVIDIA NIM — PM prose notes only (scoring stays FinBERT/lexicon).
# Key: https://build.nvidia.com/settings  (nvapi-…)
# Endpoint: https://integrate.api.nvidia.com/v1/chat/completions
# Model locked: google/gemma-4-31b-it
# NVIDIA_API_KEY=

# Force mock PM notes even if NVIDIA_API_KEY is set.
# LLM_PROVIDER=mock

# Always false — no broker / live orders.
LIVE_TRADING=false
